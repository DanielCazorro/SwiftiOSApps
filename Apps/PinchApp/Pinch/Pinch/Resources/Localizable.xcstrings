{
  "sourceLanguage": "en",
  "strings": {
    "guide.about.developer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrollo"
          }
        }
      }
    },
    "guide.about.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small magazine reader built to explore pinch, pan and zoom gestures in SwiftUI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño lector de revistas para explorar los gestos de pellizco, arrastre y zoom en SwiftUI."
          }
        }
      }
    },
    "guide.about.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión"
          }
        }
      }
    },
    "guide.doubletap.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zooms straight to the point you tapped, and tapping twice again fits the page back on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía justo por donde tocas; si vuelves a tocar dos veces, la página se ajusta de nuevo a la pantalla."
          }
        }
      }
    },
    "guide.doubletap.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces"
          }
        }
      }
    },
    "guide.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        }
      }
    },
    "guide.drag.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the page is zoomed in, drag to move around it. It never slides past its own edges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la página ampliada, arrastra para recorrerla. Nunca se sale de sus propios bordes."
          }
        }
      }
    },
    "guide.drag.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to explore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para explorar"
          }
        }
      }
    },
    "guide.drawer.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the panel on the right to jump between pages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel de la derecha para saltar entre páginas."
          }
        }
      }
    },
    "guide.drawer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page panel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel de páginas"
          }
        }
      }
    },
    "guide.pinch.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch with two fingers to zoom between 100% and 500%, right where your fingers are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca con dos dedos para ampliar entre el 100% y el 500%, justo donde tienes los dedos."
          }
        }
      }
    },
    "guide.pinch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch to zoom"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para ampliar"
          }
        }
      }
    },
    "guide.section.about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "es": {
