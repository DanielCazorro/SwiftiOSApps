    "guide.settings.haptics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptic feedback"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibración"
          }
        }
      }
    },
    "guide.swipe.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the page fitted to the screen, swipe left or right to turn to another page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la página ajustada a la pantalla, desliza a izquierda o derecha para cambiar de página."
          }
        }
      }
    },
    "guide.swipe.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para pasar"
          }
        }
      }
    },
    "guide.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona"
          }
        }
      }
    },
    "page.back.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back cover: a surprised man in a yellow hoodie holding a potted cactus, under the headline Take iOS App Development to the Next Level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraportada: un hombre sorprendido con sudadera amarilla sostiene un cactus en una maceta, bajo el titular Take iOS App Development to the Next Level."
          }
        }
      }
    },
    "page.back.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back cover"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraportada"
          }
        }
      }
    },
    "page.front.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front cover: a smiling woman in an orange jumper next to the headline Developers Spotlight, issue 24 of Pinch magazine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portada: una mujer sonriente con jersey naranja junto al titular Developers Spotlight, número 24 de la revista Pinch."
          }
        }
      }
    },
    "page.front.title": {
      "extractionState": "manual",
