    "settings.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hike that looks gorgeous in photos but is even better once you are actually there. The hike you hope to do again someday.\nFind the best day hikes in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa ruta que queda preciosa en las fotos, pero que es aún mejor cuando estás allí. Esa ruta que esperas repetir algún día.\nDescubre las mejores rutas de un día en la app."
          }
        }
      }
    },
    "settings.callToAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
