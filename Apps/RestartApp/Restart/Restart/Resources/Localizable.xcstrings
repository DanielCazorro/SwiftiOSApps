    "onboarding.character.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag left or right to move between pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra a izquierda o derecha para cambiar de página"
          }
        }
      }
    },
    "onboarding.cta.getStarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar"
          }
        }
      }
    },
    "onboarding.cta.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide the button to the right, or double tap to start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza el botón hacia la derecha, o toca dos veces para empezar"
          }
        }
      }
    },
    "onboarding.cta.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltar"
          }
        }
      }
    },
    "onboarding.give.image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration of a person offering a gift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración de una persona ofreciendo un regalo"
          }
        }
      }
    },
    "onboarding.give.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you keep for yourself you lose; what you give away, you keep forever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que guardas para ti lo pierdes; lo que regalas, lo conservas para siempre."
          }
        }
      }
    },
    "onboarding.give.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da."
          }
        }
      }
    },
    "onboarding.page.position %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page %1$lld of %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Página %1$lld de %2$lld"
          }
        }
      }
    },
    "onboarding.restart.image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration of a person starting over"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración de una persona volviendo a empezar"
          }
        }
      }
    },
    "onboarding.restart.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a breath, unplug for a moment and begin again whenever you need to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira, desconecta un momento y vuelve a empezar siempre que lo necesites."
          }
        }
      }
    },
    "onboarding.restart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia."
          }
        }
      }
    },
    "onboarding.share.image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration of a person sharing what they have"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración de una persona compartiendo lo que tiene"
          }
        }
      }
    },
    "onboarding.share.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not how much we give but how much love we put into giving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No importa cuánto damos, sino cuánto amor ponemos al dar."
          }
        }
      }
    },
    "onboarding.share.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte."
          }
        }
      }
    },
    "quote.1.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Robert Greene"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robert Greene"
          }
        }
      }
    },
    "quote.1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time that leads to mastery is dependent on the intensity of our focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo que lleva a la maestría depende de la intensidad de nuestra atención."
          }
        }
      }
    },
    "quote.2.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lao Tzu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lao Tse"
          }
        }
      }
    },
    "quote.2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journey of a thousand miles begins with a single step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje de mil millas comienza con un solo paso."
          }
        }
      }
    },
    "quote.3.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will Durant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Will Durant"
          }
        }
      }
    },
    "quote.3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are what we repeatedly do. Excellence, then, is not an act, but a habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Somos lo que hacemos repetidamente. La excelencia, entonces, no es un acto, sino un hábito."
          }
        }
      }
    },
    "quote.4.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anne Lamott"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anne Lamott"
          }
        }
      }
    },
    "quote.4.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost everything will work again if you unplug it for a few minutes, including you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todo vuelve a funcionar si lo desenchufas unos minutos, tú incluido."
          }
        }
      }
    },
    "quote.5.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "T. S. Eliot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T. S. Eliot"
          }
        }
      }
    },
    "quote.5.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every moment is a fresh beginning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada momento es un nuevo comienzo."
          }
        }
      }
    },
    "quote.6.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friedrich Nietzsche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Friedrich Nietzsche"
          }
        }
      }
    },
    "quote.6.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He who has a why to live can bear almost any how."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tiene un porqué para vivir puede soportar casi cualquier cómo."
          }
        }
      }
    }
  },
  "version": "1.0"
}
