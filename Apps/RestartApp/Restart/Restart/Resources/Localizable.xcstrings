    "home.restart.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the welcome screens again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a mostrar las pantallas de bienvenida"
          }
        }
      }
    },
